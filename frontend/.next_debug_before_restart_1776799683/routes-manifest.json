{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/admin/inquiries/[id]",
      "regex": "^/api/admin/inquiries/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/admin/inquiries/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/services/[slug]",
      "regex": "^/services/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/services/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/agri-companies",
      "regex": "^/admin/agri\\-companies(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/agri\\-companies(?:/)?$"
    },
    {
      "page": "/admin/exports",
      "regex": "^/admin/exports(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/exports(?:/)?$"
    },
    {
      "page": "/admin/inquiries",
      "regex": "^/admin/inquiries(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/inquiries(?:/)?$"
    },
    {
      "page": "/admin/login",
      "regex": "^/admin/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/login(?:/)?$"
    },
    {
      "page": "/admin/setup",
      "regex": "^/admin/setup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/setup(?:/)?$"
    },
    {
      "page": "/approach",
      "regex": "^/approach(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/approach(?:/)?$"
    },
    {
      "page": "/capabilities",
      "regex": "^/capabilities(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/capabilities(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/mobile-preview",
      "regex": "^/mobile\\-preview(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mobile\\-preview(?:/)?$"
    },
    {
      "page": "/services",
      "regex": "^/services(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services(?:/)?$"
    },
    {
      "page": "/speak-to-advisor",
      "regex": "^/speak\\-to\\-advisor(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/speak\\-to\\-advisor(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}